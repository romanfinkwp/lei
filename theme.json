{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"colors": [
						"#f0f0f0",
						"#111111"
					],
					"name": "B&W",
					"slug": "duotone-bw"
				}
			],
			"palette": [
				{
					"color": "#f0f0f0",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#888888",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#111111",
					"name": "Background",
					"slug": "background"
				},
				{
					"color": "#f0f0f0",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#1a1a1a",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#2a2a2a",
					"name": "Border",
					"slug": "border-tone"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "1",
					"size": "8px",
					"slug": "10"
				},
				{
					"name": "2",
					"size": "16px",
					"slug": "20"
				},
				{
					"name": "3",
					"size": "24px",
					"slug": "30"
				},
				{
					"name": "4",
					"size": "clamp(24px, 5vw, 32px)",
					"slug": "40"
				},
				{
					"name": "5",
					"size": "clamp(32px, 6vw, 48px)",
					"slug": "50"
				},
				{
					"name": "6",
					"size": "clamp(48px, 8vw, 80px)",
					"slug": "60"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "'Helvetica Neue', Helvetica, Arial, -apple-system, sans-serif",
					"name": "Sans",
					"slug": "sans"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"max": "12px",
						"min": "11px"
					},
					"name": "Tiny",
					"size": "12px",
					"slug": "tiny"
				},
				{
					"fluid": {
						"max": "14px",
						"min": "13px"
					},
					"name": "Small",
					"size": "14px",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "16px",
						"min": "15px"
					},
					"name": "Normal",
					"size": "16px",
					"slug": "normal"
				},
				{
					"fluid": {
						"max": "19px",
						"min": "17px"
					},
					"name": "Medium",
					"size": "19px",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "24px",
						"min": "19px"
					},
					"name": "Large",
					"size": "24px",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "30px",
						"min": "24px"
					},
					"name": "X Large",
					"size": "30px",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "38px",
						"min": "28px"
					},
					"name": "XX Large",
					"size": "38px",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "56px",
						"min": "32px"
					},
					"name": "XXX Large",
					"size": "56px",
					"slug": "xxx-large"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"radius": "0px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"bottom": "12px",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"top": "12px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--tiny)",
					"fontWeight": "400",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				}
			},
			"core/code": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/details": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"lineHeight": "1.6"
				}
			},
			"core/image": {
				"border": {
					"radius": "0px"
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--primary)"
						},
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontWeight": "400",
							"letterSpacing": "0.02em",
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--primary)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--primary)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"spacing": {
					"margin": {
						"bottom": "0px",
						"top": "0px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "400",
					"letterSpacing": "0.02em"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--primary)"
		},
		"elements": {
			"button": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"radius": "0px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"bottom": "12px",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"top": "12px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--tiny)",
					"fontWeight": "400",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--tiny)",
					"fontStyle": "italic"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.15"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.2"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.25"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"lineHeight": "1.25"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "400",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"textDecoration": "underline"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--20)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
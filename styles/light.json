{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Light",
	"settings": {
		"color": {
			"duotone": [
				{
					"colors": [
						"#111111",
						"#f5f5f5"
					],
					"name": "B&W",
					"slug": "duotone-bw"
				}
			],
			"palette": [
				{
					"color": "#111111",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#666666",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#ffffff",
					"name": "Background",
					"slug": "background"
				},
				{
					"color": "#111111",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#f5f5f5",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#e0e0e0",
					"name": "Border",
					"slug": "border-tone"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/navigation": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--primary)"
						}
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--secondary)"
							}
						},
						"color": {
							"text": "var(--wp--preset--color--primary)"
						}
					}
				}
			},
			"core/social-links": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--primary)"
		},
		"elements": {
			"button": {
				"border": {
					"color": "var(--wp--preset--color--primary)"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}